<Window x:Class="Gossip.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gossip" Width="520" Height="660" MinWidth="440" MinHeight="460"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="24,20,24,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="Gossip" Style="{StaticResource Title}"/>
        <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" Margin="1,2,0,0"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="EnterCodeButton" Content="Enter a code" Margin="0,0,8,0" Click="OnEnterCode"/>
        <Button x:Name="ShowCodeButton" Content="Show code" Style="{StaticResource AccentButton}" Click="OnShowCode"/>
      </StackPanel>
    </Grid>

    <ListBox x:Name="Devices" Grid.Row="1" SelectionMode="Single" SelectionChanged="OnSelectionChanged">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource Window}" Margin="0,0,12,0">
              <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
            </StackPanel>
            <Ellipse Grid.Column="2" Width="10" Height="10" VerticalAlignment="Center" Margin="8,0,0,0">
              <Ellipse.Style>
                <Style TargetType="Ellipse">
                  <Setter Property="Fill" Value="{DynamicResource Idle}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Online}" Value="True"><Setter Property="Fill" Value="{DynamicResource Good}"/></DataTrigger>
                  </Style.Triggers>
                </Style>
              </Ellipse.Style>
            </Ellipse>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <StackPanel x:Name="EmptyText" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30" MaxWidth="320">
      <TextBlock Text="&#xE8EA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="40" Foreground="{DynamicResource Subtle}" HorizontalAlignment="Center"/>
      <TextBlock Text="No devices yet" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4"/>
      <TextBlock Text="Choose Show code here and type it on your phone or Mac, or enter the code they show."
                 Style="{StaticResource Caption}" FontSize="13" TextWrapping="Wrap" TextAlignment="Center"/>
    </StackPanel>

    <Border x:Name="MediaPanel" Grid.Row="2" Visibility="Collapsed" Margin="0,4,0,0" Style="{StaticResource CardBorder}" Padding="14,10">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="MediaTitle" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="MediaDetail" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Content="Prev" Padding="12,5" Margin="0,0,6,0" Click="OnMediaPrevious"/>
          <Button x:Name="MediaPlay" Content="Play" Padding="12,5" Margin="0,0,6,0" Click="OnMediaPlay" Style="{StaticResource AccentButton}"/>
          <Button Content="Next" Padding="12,5" Click="OnMediaNext"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="3" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Button x:Name="SendFileButton" Content="Send file" Margin="0,0,6,0" Click="OnSendFile" IsEnabled="False"/>
      <Button x:Name="MessagesButton" Grid.Column="1" Content="Messages" Margin="0,0,6,0" Click="OnMessages" IsEnabled="False"/>
      <Button x:Name="RingButton" Grid.Column="2" Content="Ring" Margin="0,0,6,0" Click="OnRing" IsEnabled="False"/>
      <Button x:Name="RemoveButton" Grid.Column="3" Content="Remove" Style="{StaticResource DangerButton}" Click="OnRemove" IsEnabled="False"/>
    </Grid>

    <Border Grid.Row="4" Margin="0,12,0,0" Style="{StaticResource CardBorder}" Padding="14,12">
      <CheckBox x:Name="LockCheck" Checked="OnLockToggled" Unchecked="OnLockToggled">
        <StackPanel>
          <TextBlock Text="Lock this PC when my phone walks away"/>
          <TextBlock Text="Needs Bluetooth, and the phone has to allow it." Style="{StaticResource Caption}" Margin="0,2,0,0"/>
        </StackPanel>
      </CheckBox>
    </Border>
    <TextBlock x:Name="TransferText" Grid.Row="5" Style="{StaticResource Caption}" Margin="2,10,0,0" MinHeight="16"/>
  </Grid>
</Window>
