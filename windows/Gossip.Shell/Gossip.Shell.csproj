<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Windows app's engine shell: identity, sockets, mDNS and the glue to gossip-core. Builds on any OS so it can be
       tested from the Mac; only the WPF app (../Gossip.Windows) needs Windows. gossip_ffi.cs is generated by
       desktop/scripts/build-csharp-bindings.sh and not committed. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Gossip.Shell</RootNamespace>
    <AssemblyName>Gossip.Shell</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);CS8632;CS0108;CS0168;CS0219;CS8618;CS8600;CS8601;CS8602;CS8603;CS8604;CS8625;CS8765;CS0649;CS0169;CS8981;CS0162</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../desktop/target/gen/csharp/gossip_ffi.cs" Link="gossip_ffi.cs" />
    <InternalsVisibleTo Include="Gossip.Windows" />
    <InternalsVisibleTo Include="Gossip.Headless" />
    <InternalsVisibleTo Include="Gossip.Shell.Tests" />
    <PackageReference Include="Makaretu.Dns.Multicast.New" Version="0.38.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>
</Project>
