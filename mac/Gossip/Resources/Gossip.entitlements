<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Gossip is NOT sandboxed: Universal Control needs a CGEventTap (Accessibility + Input Monitoring),
	     which a sandboxed app cannot use, and the Device Mirroring launcher can be copied out directly.
	     The network entitlements are only meaningful inside a sandbox, so they are gone too. The two
	     below are still enforced under Hardened Runtime. -->
	<key>com.apple.security.device.bluetooth</key>
	<true/>
	<key>com.apple.security.personal-information.location</key>
	<true/>
</dict>
</plist>
