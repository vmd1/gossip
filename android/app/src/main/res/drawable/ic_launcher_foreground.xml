<?xml version="1.0" encoding="utf-8"?>
<!-- Mesh icon: 5 connected nodes (a small abstract network graph), replacing the old
     wifi-arcs glyph — the app is fundamentally a multi-device mesh now, not just a
     two-device Mac↔phone pairing. Node/edge layout (including the crossing B-E diagonal,
     which is what reads as "mesh" rather than "simple pentagon outline") kept within
     Android's adaptive-icon safe zone (centered, radius well under 33dp of the 54dp
     half-canvas) so nothing clips under any launcher's mask shape. Mirrors
     mac/Gossip/Assets.xcassets's app icon design — see docs/design-system.md for the
     accent color (background) this pairs with. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Edges, drawn first so node circles sit on top of their endpoints. -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.7"
        android:strokeLineCap="round"
        android:pathData="M52,33 L33,47 M52,33 L75,46 M33,47 L75,46 M33,47 L38,73 M75,46 L68,71 M38,73 L68,71 M33,47 L68,71" />
    <!-- Nodes -->
    <path android:fillColor="#FFFFFF" android:pathData="M48,33 A4,4 0 1,0 56,33 A4,4 0 1,0 48,33 Z" />
    <path android:fillColor="#FFFFFF" android:pathData="M29,47 A4,4 0 1,0 37,47 A4,4 0 1,0 29,47 Z" />
    <path android:fillColor="#FFFFFF" android:pathData="M71,46 A4,4 0 1,0 79,46 A4,4 0 1,0 71,46 Z" />
    <path android:fillColor="#FFFFFF" android:pathData="M34,73 A4,4 0 1,0 42,73 A4,4 0 1,0 34,73 Z" />
    <path android:fillColor="#FFFFFF" android:pathData="M64,71 A4,4 0 1,0 72,71 A4,4 0 1,0 64,71 Z" />
</vector>
