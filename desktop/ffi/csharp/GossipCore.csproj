<Project Sdk="Microsoft.NET.Sdk">
  <!-- The C# binding over gossip-core. gossip_ffi.cs is generated by scripts/build-csharp-bindings.sh (not committed). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <StartupObject>SmokeTest</StartupObject>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Gossip.Core</RootNamespace>
    <AssemblyName>Gossip.Core</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../target/gen/csharp/gossip_ffi.cs" Link="gossip_ffi.cs" />
  </ItemGroup>
</Project>
